{
  "name": "industrial_web_os",

  "agents": [
    "industrial_business_research_a",
    "industrial_website_architect"
  ],

  "tasks": [
    {
      "name": "research_company",

      "description": "Research {company_name} using {website_url} as the primary source. Follow the research-related structure defined in knowledge/schema/company_knowledge.json. Use the available research tools to examine the homepage and relevant accessible internal pages such as About, Services, Products, Industries, Projects, Resources, Support, Contact, Certifications, Sustainability, News, and other material pages discovered during research. Use public search only to identify relevant company pages or fill important gaps. Prioritize primary company sources over secondary sources. Record only pages and sources that were actually returned by the available tools. A page may only use analysis_status analyzed when usable content was successfully retrieved. If a page was discovered but could not be retrieved, record it as skipped, failed, or blocked and provide the reason. A missing, unavailable, blocked, failed, inaccessible, timed-out, or not-found page must never simultaneously be classified as analyzed. Before returning the final result, perform a consistency review across research_metrics.scope, research_metrics.coverage, research_metrics.pages, research_metrics.sources, research_metrics.limitations, website_analysis, and verification. Resolve contradictions before returning the answer. Confirmed facts must be traceable to at least one entry under research_metrics.sources. Use each source's used_for_claims array to identify the claims or claim categories it supports. The source record must provide the source URL, source name, source type, publisher when available, retrieval date, primary-source status, and supported claims. Do not invent source URLs, quotations, certifications, awards, customers, testimonials, projects, partnerships, locations, statistics, capabilities, dates, crawl activity, execution timing, HTTP statuses, content lengths, token usage, costs, model routing, fallback activity, retry counts, or tool-call counts. Automatically measured information that is unavailable must retain its default empty, zero, false, or null value and must be listed under research_metrics.audit.unavailable_fields. Do not claim that a metric was automatically measured unless code, the retrieval tool, CrewAI runtime output, or tracing actually supplied it. Separate confirmed facts, inferred facts, assumptions, contradictions, and information requiring client confirmation. Return only valid JSON without markdown, code fences, introduction, or commentary.",

      "expected_output": "Return one valid JSON object containing metadata, research, research_metrics, website_analysis, architecture, verification, patterns, business_intelligence, outcomes, and memory. Follow knowledge/schema/company_knowledge.json as the canonical structure. Populate the research-related sections and leave sections owned by later pipeline stages at their default values. metadata.company_name and metadata.website_url must be non-empty. research_metrics must contain status, scope, coverage, pages, sources, crawl_performance, content_quality, evidence_quality, research_quality, execution, limitations, and audit. Every research_metrics.pages entry must use exactly one analysis_status value: analyzed, skipped, failed, or blocked. Every confirmed fact must be supported by at least one entry in research_metrics.sources whose used_for_claims array identifies that fact or its claim category. Exact quotations are not required unless they were actually retrieved. Sources must not be invented. If evidence is insufficient, classify the information as inferred, assumed, or requiring client confirmation instead of confirmed. Automatically measured fields that were not measured must retain default values and be included under research_metrics.audit.unavailable_fields.",

      "agent": "industrial_business_research_a",

      "output_file": "runs/latest/research.json",

      "create_directory": true,

      "markdown": false,

      "guardrails": [
        "The response must be one valid JSON object with no markdown, code fences, introduction, or commentary.",

        "The output must follow the research-related structure in knowledge/schema/company_knowledge.json. metadata.company_name and metadata.website_url must be present and non-empty.",

        "The output must be internally consistent. A page cannot simultaneously be analyzed and missing, analyzed and inaccessible, analyzed and blocked, analyzed and unavailable, analyzed and not found, or analyzed and failed. A page may use analysis_status analyzed only when usable page content was retrieved.",

        "Confirmed facts must be traceable to research_metrics.sources through used_for_claims. A source may support an individual claim or a clearly named claim category such as company identity, services, products, industries served, production capabilities, company history, mission, values, contact details, or location. Do not require a quotation when no quotation was retrieved, but do require a genuine supporting source URL. If a claim is not supported by a listed source, move it to inferred_facts, assumptions, or requires_client_confirmation.",

        "research_metrics.evidence_quality must agree with the actual verification and source records. claims_with_evidence cannot exceed the number of claims traceable through research_metrics.sources. confirmed_claims must not include unsupported claims.",

        "Do not fabricate pages visited, sources, URLs, excerpts, certifications, customers, awards, testimonials, projects, partnerships, locations, capabilities, statistics, execution timing, HTTP statuses, content lengths, token usage, costs, model routing, fallbacks, retries, or tool-call counts.",

        "Automatically measured metrics that are unavailable must retain their default empty, zero, false, or null values and must be listed under research_metrics.audit.unavailable_fields.",

        "The verification section must clearly separate confirmed facts, inferred facts, assumptions, contradictions, and information requiring client confirmation.",

        "Coverage and confidence must reflect the evidence actually collected. Limited page coverage must not be described as comprehensive research or assigned unjustifiably high confidence."
      ],

      "guardrail_max_retries": 3,

      "human_input": false,

      "async_execution": false
    },

    {
      "name": "create_website_architecture",

      "description": "Using the completed JSON output from research_company as the authoritative company-specific source, create a complete evidence-driven B2B website architecture for {company_name}. Fully utilize verified research instead of applying a generic template. Every confirmed service must appear somewhere within the sitemap, navigation, homepage, service overview, service detail-page plan, content hierarchy, or implementation roadmap. Confirmed products must influence the architecture. When more than five products are confirmed, include a dedicated Products page recommendation. When more than ten products are confirmed, organize them into practical categories and recommend filtering or product discovery. Every confirmed trust signal must become a confirmed trust element supported by research evidence. Never downgrade a confirmed research fact to inferred or requires_client_confirmation without documenting a genuine contradiction. Every unique selling proposition must influence homepage messaging, value propositions, or trust sections. Every major target audience must have an appropriate message, content path, or conversion route. Research pain points must influence conversion messaging, CTAs, FAQs, resources, or supporting content. Research opportunities must influence growth-phase recommendations. Strategic recommendations are allowed, but must not be presented as existing company facts. Do not invent certifications, statistics, awards, project counts, customer counts, client names, safety metrics, offices, partnerships, testimonials, case studies, product availability, capabilities, performance claims, or achievements. Every trust element must use one status: confirmed, inferred, or requires_client_confirmation. Future case studies, brochures, resources, galleries, testimonials, certifications, calculators, downloads, and project portfolios must be marked requires_client_confirmation when research does not confirm that they currently exist. Adapt the architecture to the company's actual services, products, audiences, strengths, weaknesses, opportunities, research coverage, and confidence. Before returning the answer, verify that no confirmed service, product category, trust signal, USP, audience, pain point, opportunity, or commercially useful research finding was omitted without explanation. Return only valid JSON without markdown, code fences, introduction, or commentary.",

      "expected_output": "Return one valid JSON object containing sitemap, navigation, cta_strategy, trust_elements, seo_recommendations, homepage, pages, implementation_priority, research_utilization, and verification. Sitemap entries must contain url, title, description, status, and evidence. CTA entries must contain type, placement, text, url, status, and evidence. Every trust element must contain type, placement, status, description, and evidence. Confirmed items must reference supporting research. Evidence must be null when direct supporting evidence is unavailable. The homepage must contain hero_section, service_highlights, product_highlights when products exist, trust_section, audience_paths, value_propositions, supporting_content, and final_cta. The pages object must include every page justified by the research. implementation_priority must contain phase_1_mvp, phase_2_growth, and phase_3_authority. research_utilization must contain services_mapped, products_mapped, trust_signals_mapped, usps_mapped, audiences_mapped, pain_points_mapped, opportunities_mapped, and omitted_research_items. verification must contain confirmed_facts_used, inferred_recommendations, assumptions, requires_client_confirmation, research_confidence_used, and research_limitations.",

      "agent": "industrial_website_architect",

      "context": [
        "research_company"
      ],

      "output_file": "runs/latest/architecture.json",

      "create_directory": true,

      "markdown": false,

      "guardrails": [
        "The response must be one valid JSON object with no markdown, code fences, introduction, or commentary.",

        "The architecture must be based on research_company and must not introduce factual company claims absent from the research.",

        "Every confirmed service must be represented somewhere within the architecture. Confirmed products must influence the architecture. If more than five products are confirmed, include a dedicated Products page recommendation.",

        "Every trust element must use exactly one status: confirmed, inferred, or requires_client_confirmation. Confirmed trust elements must have supporting research evidence.",

        "A confirmed research fact must not be downgraded to inferred or requires_client_confirmation unless verification documents a genuine contradiction.",

        "Unsupported certifications, testimonials, customers, awards, statistics, projects, partnerships, locations, capabilities, and achievements must be marked requires_client_confirmation.",

        "Proposed resources, downloads, case studies, galleries, calculators, and content assets must not be presented as existing company assets unless the research confirms them.",

        "research_utilization must account for mapped services, products, trust signals, USPs, audiences, pain points, opportunities, and deliberately omitted research items.",

        "verification must clearly separate confirmed facts, inferred recommendations, assumptions, limitations, and items requiring client confirmation."
      ],

      "guardrail_max_retries": 3,

      "human_input": false,

      "async_execution": false
    }
  ],

  "process": "sequential",

  "verbose": true,

  "memory": false,

  "cache": true,

  "max_rpm": 20,

  "output_log_file": "runs/latest/crew_log.json",

  "stream": false,

  "inputs": {}
}